{
  "appId": "com.subrat.musicone",
  "appName": "MusicOne",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "hostname": "themusic.one",
    "iosScheme": "https",
    "androidScheme": "https",
    "allowNavigation": [
      "*"
    ]
  },
  "ios": {
    "contentInset": "automatic",
    "allowsLinkPreview": false,
    "scrollEnabled": true
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "CapacitorCookies": {
      "enabled": true
    }
  }
}
